#!/bin/sh
set -e

lb config noauto \
    --mode debian \
    --distribution bookworm \
    --architectures amd64 \
    --binary-images iso-hybrid \
    --bootloaders grub-efi \
    --debian-installer none \
    --archive-areas "main contrib non-free non-free-firmware" \
    --linux-flavours amd64 \
    --iso-application "Nexo Universal" \
    --iso-publisher "Nexo Universal Project" \
    --iso-volume "NEXO_UNIVERSAL" \
    --image-name "nexo-universal" \
    --memtest none \
    "${@}"
