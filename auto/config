#!/bin/sh
set -e

lb config noauto \
    --mode debian \
    --distribution bookworm \
    --architectures amd64 \
    --binary-images iso-hybrid \
    --bootloaders grub-efi \
    --debian-installer none \
    --archive-areas "main contrib non-free non-free-firmware" \
    --linux-flavours amd64 \
    --apt-recommends false \
    --iso-application "Nexo Universal" \
    --iso-publisher "Nexo Universal Project" \
    --iso-volume "NEXO_UNIVERSAL" \
    --image-name "nexo-universal" \
    --memtest none \
    --bootappend-live "boot=live components quiet username=nexo hostname=nexo locales=ru_RU.UTF-8 keyboard-layouts=us,ru,ua keyboard-options=grp:alt_shift_toggle timezone=Europe/Kyiv" \
    "${@}"
